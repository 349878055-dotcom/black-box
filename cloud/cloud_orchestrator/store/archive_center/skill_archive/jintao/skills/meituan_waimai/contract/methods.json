      "need_login": false,
      "params": {},
      "customer_input": [],
      "keywords": [
        "首页",
        "附近店铺",
        "有什么店"
      ],
      "provides": {
        "poi_id": {
          "desc": "店铺 id，供 get_poi_info/get_product_list/generate_order_link 使用",
          "used_by": [
            "get_poi_info",
            "get_product_list",
            "generate_order_link"
          ]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false,
      "stage": "final",
      "deliver": "query"
    },
    {
      "name": "search_poi",
      "desc": "搜店铺（选择源）→ wx-shangou.meituan.com/wxapp/v2/search/v9/poiwithfilter（search 系可能 403，可改用 homepage）。返回 [{poi_id, name, ...}]。先调本方法拿候选店铺，再 ask_user 让客户从候选里选店，把选中的 poi_id 填进 get_poi_info/get_product_list/generate_order_link。keyword 为客户提供的店名/搜索词，客户没说想吃哪家时先 ask_user 问",
      "need_login": false,
      "params": {
        "keyword": "店铺名/搜索词",
        "city_id": "城市id（待验证）",
        "lng": "经度（待验证）",
        "lat": "纬度（待验证）"
      },
      "customer_input": [
        "keyword"
      ],
      "keywords": [
        "搜店铺",
        "找外卖",
        "点外卖",
        "附近有什么吃的"
      ],
      "provides": {
        "poi_id": {
          "desc": "店铺 id，供 get_poi_info/get_product_list/generate_order_link 使用",
          "used_by": [
            "get_poi_info",
            "get_product_list",
            "generate_order_link"
          ]
        }
      },
      "success_ret": "店铺列表",
      "error_ret": "",
      "system_only": false,
      "stage": "final",
      "deliver": "query"
    },
