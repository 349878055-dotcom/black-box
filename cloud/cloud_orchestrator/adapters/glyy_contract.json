{
  "id": "glyy",
  "name": "南京鼓楼医院互联网医院",
  "site": "南京鼓楼医院（微信小程序「南京鼓楼医院互联网医院」appid wx74a991a2ae77468d）",
  "base": "https://www.ih.njglyy.com:9532/caring/api",
  "intent": "挂号预约：查科室/医生/排班/时段 → 提交预约 → 查订单/取消",
  "auth": {
    "required": true,
    "kind": "token",
    "how_to_get": "① 形式：Bearer token（access_token）。② 从哪来：云端 API 短信登录（POST /v4/session/phone，3 步：抓图形验证码 → 发短信 → 登录），无需内置浏览器/抓包。③ 要不要人配合：要——人看图输图形验证码 + 看手机输短信验证码；成功后 token 存 data/sessions/glyy_session.json 持久化，重启不丢。",
    "how": "手机号+短信验证码登录（POST /v4/session/phone，Basic hospital:hospital-secret）；或抓包注入真实 token。请求带 Authorization: Bearer <access_token>；过期用 PUT /session?refresh_token=xxx 刷新。",
    "sign": "所有请求必须带签名头：appKey=1340patient、timestamp(毫秒)、nonce(随机)、sign=SHA1(MD5(appKey+timestamp+nonce))；UA 必须用微信手机 UA，否则服务器挂起",
    "login_site": "图形验证码: POST /sms/captcha?phone=；发短信: POST /sms?phone=&type=1&code=<图形验证码>（Basic sms:smssecret）"
  },
  "endpoints": [
    {
      "name": "登录(手机验证码)",
      "method": "POST",
      "path": "/v4/session/phone",
      "params": {
        "phone": "{phone}"
      },
      "body": {
        "phone": "{phone}",
        "code": "{sms_code}"
      },
      "headers": {
        "Authorization": "Basic aG9zcGl0YWw6aG9zcGl0YWwtc2VjcmV0"
      },
      "content_type": "json",
      "need_login": false,
      "method_name": "login",
      "desc": "手机号+短信验证码登录 → {access_token, refresh_token, ...}",
      "success": "code=0",
      "note": "query 和 body 都要带 phone/code",
      "keywords": [
        "登录(手机验证码)"
      ],
      "examples": [
        "登录(手机验证码)"
      ]
    },
    {
      "name": "查科室",
