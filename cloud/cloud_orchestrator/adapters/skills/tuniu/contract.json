{
  "id": "tuniu",
  "name": "途牛（查：MCP 查询；买：M 站下单+支付）",
  "capability": "operate",
  "capability_note": "查票（MCP 免登录）；下单（M 站，需登录 cookie，乘客直传 touristList）；支付在手机支付宝/途牛 App 完成（需真人确认）",
  "flow": [
    {
      "step": 1,
      "title": "① 查车次/机票/酒店/门票（MCP，免费）",
      "methods": [
        "search_train",
        "search_flight",
        "search_hotel",
        "search_ticket"
      ]
    },
    {
      "step": 2,
      "title": "② 车次详情（MCP）",
      "methods": [
        "train_detail"
      ]
    },
    {
      "step": 3,
      "title": "③ 下单创建订单（M站，乘客直传 touristList）⚠️真购票",
      "methods": [
        "submit_order"
      ]
    },
    {
      "step": 4,
      "title": "④ 支付（内置浏览器打开订单页/收银台，手机支付宝/途牛 App 完成）",
      "methods": [
        "pay"
      ]
    },
    {
      "step": 5,
      "title": "⑤ 订单列表/订单详情/出票状态（M站）",
      "methods": [
        "order_list",
        "order_detail"
      ]
    },
    {
      "step": 6,
      "title": "⑥ 退票/取消订单（M站）⚠️真实退票",
      "methods": [
        "cancel_order"
      ]
    }
  ],
  "methods": [
    {
      "name": "list_tools",
      "desc": "列出某分类可用工具（flight/train/hotel/ticket/cruise/holiday）",
      "need_login": false,
      "params": {
        "category": "分类，默认 train"
      },
      "keywords": [
        "工具",
        "可用功能"
      ],
      "success_ret": "工具列表 [{name,desc}]",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "search_train",
      "desc": "火车票搜索（MCP，免费，仅查询）→ 车次+票价+余票",
      "need_login": false,
      "params": {
        "departure": "出发城市",
        "arrival": "到达城市",
        "date": "YYYY-MM-DD"
      },
      "keywords": [
        "火车票",
        "高铁",
        "动车",
        "车次",
        "查火车",
        "买火车票"
      ],
      "success_ret": "{ok, trains:[{trainNum,departureTime,arrivalTime,seat:{seatName,price,leftNumber}}]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "train_detail",
      "desc": "车次详情（MCP，站点/时刻/席位；需带出发/到达城市名）",
      "need_login": false,
      "params": {
        "train_num": "车次号",
        "date": "YYYY-MM-DD",
        "departure": "出发城市（可选）",
        "arrival": "到达城市（可选）"
      },
      "keywords": [
        "车次详情",
        "时刻表",
        "站点",
        "途经站"
      ],
      "success_ret": "{ok, train:{trainNum,stations,seats}}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "search_flight",
      "desc": "机票搜索（MCP）→ 航班列表（低价）",
      "need_login": false,
      "params": {
        "departure": "出发城市",
        "arrival": "到达城市",
        "date": "YYYY-MM-DD"
      },
      "keywords": [
        "机票",
        "航班",
        "飞机",
        "打折机票",
        "坐飞机"
      ],
      "success_ret": "{ok, flights:[]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "search_hotel",
      "desc": "酒店搜索（MCP）→ 酒店列表",
      "need_login": false,
      "params": {
        "city": "城市",
        "check_in": "入住日期",
        "check_out": "离店日期"
      },
      "keywords": [
        "酒店",
        "宾馆",
        "住宿",
        "订房",
        "开房"
      ],
      "success_ret": "{ok, hotels:[]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "search_ticket",
      "desc": "景点门票查询（MCP）",
      "need_login": false,
      "params": {
        "scenic_name": "景点名"
      },
      "keywords": [
        "门票",
        "景点",
        "景区",
        "门票价格"
      ],
      "success_ret": "{ok, tickets:[]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "set_cookies",
      "desc": "设置 M 站登录 cookie（下单前调用；手机通道下由手机凭据库自动补）",
      "need_login": false,
      "params": {
        "cookies": "登录cookie字典"
      },
      "keywords": [
        "登录",
        "cookie"
      ],
      "success_ret": "{ok}",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "resolve_city_code",
      "desc": "查途牛城市代码（下单前可先查出发/到达城市的 cityCode；submit_order 缺代码时也会自动调用，一般无需手动）",
      "need_login": false,
      "params": {
        "city": "城市名（如：南京/镇江/北京）"
      },
      "keywords": [
        "城市代码",
        "查城市",
        "citycode",
        "途牛城市"
      ],
      "success_ret": "{ok, city, city_code}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "submit_order",
      "desc": "下单创建订单（M站 AddOrder，乘客直传 touristList，免网页添加乘客弹窗）⚠️真购票",
      "need_login": true,
      "params": {
        "dep": "出发城市",
        "arr": "到达城市",
        "date": "YYYY-MM-DD",
        "train_num": "车次",
        "seat_name": "席别",
        "passengers": "乘客数组[{name,psptId,tel,birthday,sex}]",
        "contact_tel": "联系人手机"
      },
      "keywords": [
        "买票",
        "下单",
        "订票",
        "购买",
        "买火车票"
      ],
      "success_ret": "{ok, order_id, order_amount, pay_url}",
      "error_ret": "{ok:false, error, need_login?}（170001参数错误/179998未登录→need_login）",
      "system_only": false
    },
    {
      "name": "pay",
      "desc": "支付：内置浏览器打开途牛收银台，选支付宝自动拉起支付宝 App 完成支付（alipays://，桌面弹出支付宝）",
      "need_login": true,
      "params": {
        "order_id": "订单号",
        "order_type": "订单类型(默认38)"
      },
      "keywords": [
        "支付",
        "付款",
        "付钱",
        "支付宝",
        "拉起支付宝"
      ],
      "success_ret": "{ok, pay_url, pay_ways:[]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "order_detail",
      "desc": "订单详情（M站，状态/金额/可否支付取消；支付后确认用）",
      "need_login": true,
      "params": {
        "order_id": "订单号",
        "order_type": "订单类型(默认38)"
      },
      "keywords": [
        "订单详情",
        "订单状态",
        "查订单",
        "支付成功了吗"
      ],
      "success_ret": "{ok, order:{statusName(待出票/购票成功), orderStatusCode, payStatusName, canPay, canCancel, ticketInfo, touristsInfo, refundServiceFee}}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    },
    {
      "name": "cancel_order",
      "desc": "退票/取消订单：①未支付/占座订单 → newCancelOrder 自动退（实测成功）；②已出票订单途牛网页无自助退票（平台限制）→ 自动退不了，需告知用户打途牛客服 400-797-6666 或凭证件到火车站窗口办理（按铁路规则扣手续费）",
      "need_login": true,
      "params": {
        "order_id": "订单号",
        "order_type": "订单类型(默认38)"
      },
      "keywords": [
        "退票",
        "取消订单",
        "退",
        "退掉",
        "怎么退票",
        "退票入口"
      ],
      "success_ret": "{ok, data:{success:true}}",
      "error_ret": "{ok:false, error}（已出票→711001取消失败，需转客服/窗口）",
      "system_only": false
    },
    {
      "name": "order_list",
      "desc": "我的火车票订单列表（M站 orderList）→ 订单号/状态/金额/乘车日期；查询票务用",
      "need_login": true,
      "params": {
        "page_no": "页码(默认1)",
        "page_size": "每页条数(默认10)"
      },
      "keywords": [
        "订单列表",
        "我的订单",
        "查询票务",
        "我买的票",
        "查订单",
        "订单"
      ],
      "success_ret": "{ok, orders:[{orderId, beginTime, productName, status, amount}]}",
      "error_ret": "{ok:false, error}",
      "system_only": false
    }
  ]
}