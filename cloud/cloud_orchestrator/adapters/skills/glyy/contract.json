          "field": "dept_code",
          "note": "先调 list_depts 拿到目标科室的真实 dept_code，禁止编造"
        }
      ],
      "provides": {
        "doctor_code": {
          "desc": "医生代码，供 register 使用",
          "used_by": ["register"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
