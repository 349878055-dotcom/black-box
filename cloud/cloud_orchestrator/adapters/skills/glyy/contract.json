      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "cancel_reservation",
      "desc": "取消预约（⚠️7天内退约次数有限制）",
      "need_login": true,
      "params": {
        "schedule_id": ""
      },
      "keywords": [
