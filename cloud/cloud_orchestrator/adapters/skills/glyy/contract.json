    {
      "name": "register",
      "desc": "提交挂号（POST /public/v3/register）⚠️真挂号有副作用，须用户确认。需登录；参数由前置查询方法提供（见 requires），禁止编造编码",
      "need_login": true,
      "params": {
        "dept_code": "真实科室代码",
        "dept_name": "科室名",
        "doctor_code": "医生代码",
        "doctor_name": "医生名",
        "appointment_time": "YYYY-MM-DD",
        "noon_code": "午别",
        "schedule_id": "排班 id",
        "schedule_num_id": "时段号 id",
        "start_hour": "时段时间",
        "reg_type": "号别类型",
        "reg_name": "号别名",
        "res_title_code": "职称代码",
        "res_title_name": "职称名",
        "reg_fee": "挂号费",
        "business_type": "1|2",
        "patient": "患者信息对象（来自 get_patient）"
      },
      "keywords": [
        "挂号",
        "预约",
        "提交"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "match": { "dept_name": "dept_name" },
          "note": "先用用户给的科室名在 list_depts 结果里精确匹配，取真实 dept_code"
        },
        {
          "param": "dept_name",
          "from": "list_depts",
          "field": "dept_name",
          "match": { "dept_name": "dept_name" },
          "note": "与 dept_code 对应的科室名（用科室名匹配锁定）"
        },
        {
          "param": "doctor_code",
          "from": "get_schedule",
          "field": "doctor_code",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "用医生名在 get_schedule 排班（normal/expert）里精确匹配，取排班条目的 doctor_code"
        },
        {
          "param": "doctor_name",
          "from": "get_schedule",
          "field": "doctor_name",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的医生名（用医生名匹配锁定）"
        },
        {
          "param": "schedule_id",
          "from": "get_schedule",
          "field": "schedule_id",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "用医生名匹配锁定排班，取真实 schedule_id"
        },
        {
          "param": "schedule_num_id",
          "from": "get_schedule",
          "field": "detail.schedule_num_id",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "get_schedule 匹配排班的 detail 里的 schedule_num_id"
        },
        {
          "param": "start_hour",
          "from": "get_schedule",
          "field": "detail.time_part",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "get_schedule 匹配排班的 detail 里的 time_part"
        },
        {
          "param": "noon_code",
          "from": "get_schedule",
          "field": "noon_code",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 noon_code（用医生名匹配锁定）"
        },
        {
          "param": "reg_type",
          "from": "get_schedule",
          "field": "reg_type",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 reg_type"
        },
        {
          "param": "reg_name",
          "from": "get_schedule",
          "field": "reg_name",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 reg_name"
        },
        {
          "param": "res_title_code",
          "from": "get_schedule",
          "field": "res_title_code",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 res_title_code"
        },
        {
          "param": "res_title_name",
          "from": "get_schedule",
          "field": "res_title_name",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 res_title_name"
        },
        {
          "param": "reg_fee",
          "from": "get_schedule",
          "field": "reg_fee",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 reg_fee"
        },
        {
          "param": "business_type",
          "from": "get_schedule",
          "field": "business_type",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code", "date": "appointment_time" },
          "note": "排班条目里的 business_type"
        },
        {
          "param": "patient",
          "from": "get_patient",
          "field": "patient",
          "note": "先调 get_patient 拿患者信息对象（患者通常唯一，取默认）"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
