        "list_doctors",
        "get_available_dates",
        "get_schedule",
        "get_patient",
        "register",
        "list_orders"
      ]
    }
  ],
  "methods": [
    {
      "name": "login",
      "desc": "手机号+短信验证码登录 → {access_token, refresh_token, ...}",
      "need_login": false,
      "params": {
        "phone": "{phone}"
      },
      "keywords": [
        "登录(手机验证码)"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_depts",
      "desc": "科室列表（533个）→ [{dept_code, dept_name, branch_code}]",
      "need_login": false,
      "params": {},
      "keywords": [
        "科室",
        "医院科室",
        "有哪些科"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_doctors",
      "desc": "科室医生 → [{doctor_code, doctor_name, title, intro}]",
      "need_login": false,
      "params": {},
      "keywords": [
        "医生",
        "专家",
        "大夫"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_available_dates",
      "desc": "可预约日期列表（business_type 1=普通号 2=专家号）",
      "need_login": false,
      "params": {
        "begin_date": "YYYY-MM-DD",
        "end_date": "YYYY-MM-DD",
        "branch_code": "1",
        "business_type": "1|2",
        "res_src": "801"
      },
      "keywords": [
        "可约日期",
        "哪天能约",
        "放号"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_schedule",
      "desc": "排班 → {normal:[...], expert:[...]}，每条含 schedule_id/reg_fee/noon_code/doctor + detail(时段数组: time_part/schedule_num_id/remaining_num/is_enable)",
      "need_login": false,
      "params": {
        "begin_date": "YYYY-MM-DD",
        "end_date": "YYYY-MM-DD",
        "schedule_type": "1|2",
        "type": "0|1",
        "branch_code": "1",
        "need_detail": "true",
        "business_type": "1|2",
        "res_src": "801"
      },
      "keywords": [
        "排班",
        "出诊时间",
        "哪天有号"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_patient",
      "desc": "患者信息 → {patient_codes, name, id_card(脱敏), phone}；另 /user/patient/all 返回完整列表",
      "need_login": true,
      "params": {},
      "keywords": [
        "我的信息",
        "就诊人",
        "患者"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "register",
      "desc": "提交预约（⚠️真挂号有副作用，须用户确认）",
      "need_login": true,
      "params": {},
      "keywords": [
        "挂号",
        "预约",
        "提交"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
