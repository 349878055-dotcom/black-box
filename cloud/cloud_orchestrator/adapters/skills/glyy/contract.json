{
  "id": "glyy",
  "name": "南京鼓楼医院互联网医院",
  "capability": "query+operate",
  "capability_note": "路径 A：查科室/医生/可约日期/排班（公开，免登录）；挂号代做（持有短信 token，内置浏览器真人配合），给 pay_url，客户只确认付款。",
  "flow": [
    {
      "step": 1,
      "title": "① 查科室/医生（公开）",
      "methods": [
        "list_depts",
        "list_doctors",
        "online_search"
      ]
    },
    {
      "step": 2,
      "title": "② 查可约日期/排班（公开）",
      "methods": [
        "get_available_dates",
        "get_schedule",
        "online_doctor_schedule"
      ]
    },
    {
      "step": 3,
      "title": "③ 登录（系统自动处理，无需 AI 调用）",
      "methods": []
    },
    {
      "step": 4,
      "title": "④ 在线挂号（⚠️真挂号，需登录+确认）",
      "methods": [
        "get_patient",
        "register"
      ]
    },
    {
      "step": 5,
      "title": "⑤ 我的就诊/订单",
      "methods": [
        "list_orders",
        "cancel_reservation",
        "visit_records"
      ]
    },
    {
      "step": 6,
      "title": "⑥ 病历/处方/缴费",
      "methods": [
        "list_reports",
        "clinic_no_paid",
        "get_recipe",
        "medical_pay"
      ]
    }
  ],
  "login": {
    "method": "sms_verify",
    "display": "南京鼓楼医院互联网医院",
    "steps": {
      "captcha": {
        "method": "get_graphical_captcha",
        "params": {
          "phone": "{phone}"
        },
        "image_field": "image_base64"
      },
      "send_sms": {
        "method": "send_sms",
        "params": {
          "phone": "{phone}",
          "gcode": "{captcha_code}"
        }
      },
      "login": {
        "method": "login",
        "params": {
          "phone": "{phone}",
          "code": "{sms_code}"
        }
      }
    },
    "interact": {
      "phone": "请输入手机号，完成鼓楼医院登录",
      "captcha_image": "请输入图形验证码（看上方图片里的字符）",
      "sms_code": "短信已发送，请输入收到的验证码"
    }
  },
  "methods": [
    {
      "name": "login",
      "desc": "手机号+短信验证码登录（登录由系统自动处理：内置浏览器真人配合，AI 无需调用本方法）",
      "need_login": false,
      "params": {
        "phone": "{phone}",
        "code": "短信验证码"
      },
      "keywords": [],
      "system_only": true
    },
    {
      "name": "get_graphical_captcha",
      "desc": "步骤1：获取图形验证码 base64（系统登录编排用，AI 无需调用）",
      "need_login": false,
      "params": {
        "phone": "手机号"
      },
      "keywords": [],
      "system_only": true
    },
    {
      "name": "send_sms",
      "desc": "步骤2：发送短信验证码（系统登录编排用，AI 无需调用）",
      "need_login": false,
      "params": {
        "phone": "手机号",
        "gcode": "图形验证码"
      },
      "keywords": [],
      "system_only": true
    },
    {
      "name": "list_depts",
      "desc": "科室列表（533个）→ [{dept_code, dept_name, branch_code}]",
      "need_login": false,
      "params": {},
      "keywords": [
        "科室",
        "医院科室",
        "有哪些科"
      ],
      "provides": {
        "dept_code": {
          "desc": "科室编码，供 list_doctors/get_available_dates/get_schedule/register 使用",
          "used_by": ["list_doctors", "get_available_dates", "get_schedule", "register"]
        },
        "dept_name": {
          "desc": "科室名，供 register 使用",
          "used_by": ["register"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_doctors",
      "desc": "科室医生 → [{doctor_code, doctor_name, title, intro}]",
      "need_login": false,
      "params": {
        "dept_code": "真实科室代码"
      },
      "keywords": [
