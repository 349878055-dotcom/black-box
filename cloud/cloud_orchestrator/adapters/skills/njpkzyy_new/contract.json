{
  "id": "njpkzyy_new",
  "name": "南京市浦口区中医院挂号",
  "capability": "query+operate_wechat",
  "capability_note": "查科室/医生/午别/可约日期/排班/在线号/时段/支付渠道（公开，免登录）；微信授权登录+在线挂号需真人配合（App 不能代做微信授权，挂号需用户确认）。",
  "aliases": [
    "浦口中医院",
    "南京市浦口区中医院",
    "njpkzyy",
    "pkqzyy"
  ],
  "flow": [
    {
      "step": 1,
      "title": "① 查科室/医生/午别（公开）",
      "methods": [
        "list_depts",
        "list_noon_codes",
        "list_dept_doctors"
      ]
    },
    {
      "step": 2,
      "title": "② 查可约日期/排班/在线号/时段/支付渠道（公开）",
      "methods": [
        "get_available_dates",
        "get_schedule",
        "judge_online",
        "get_schedule_detail",
        "get_pay_channels"
      ]
    },
    {
      "step": 3,
      "title": "③ 微信授权登录（真人配合）",
      "methods": [
        "wechat_login"
      ]
    },
    {
      "step": 4,
      "title": "④ 在线挂号（⚠️真挂号，需登录+确认）",
      "methods": [
        "register_online"
      ]
    },
    {
      "step": 5,
      "title": "⑤ 就诊卡/订单查询（需登录）",
      "methods": [
        "get_medical_card",
        "get_order",
        "get_order_goods"
      ]
    },
    {
      "step": 6,
      "title": "⑥ 公告/协议",
      "methods": [
        "list_notices",
        "get_notice_detail"
      ]
    }
  ],
  "methods": [
    {
      "name": "list_depts",
      "desc": "科室列表（两级：父科室 pid 分组 + 子科室）→ [{dept_code, dept_name, pid, ...}]，与小程序页面一致",
      "need_login": false,
      "params": {
        "branch_code": ""
      },
      "keywords": [
        "科室",
        "有哪些科",
        "浦口中医院科室"
      ],
      "provides": {
        "dept_code": {
          "desc": "科室编码（真实科室代码），供 list_dept_doctors/get_available_dates/get_schedule/judge_online/register_online 使用",
          "used_by": ["list_dept_doctors", "get_available_dates", "get_schedule", "judge_online", "register_online"]
        },
        "dept_name": {
          "desc": "科室名，供 register_online 使用",
          "used_by": ["register_online"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_noon_codes",
      "desc": "午别/时段编码 → [{noon_name, noon_code(1上午/2下午/3夜间/6全天), time_part}]",
      "need_login": false,
      "params": {
        "branch_code": "",
        "branch_name": ""
      },
      "keywords": [
        "午别",
        "上午",
        "下午",
        "号源时段"
      ],
      "provides": {
        "noon_code": {
          "desc": "午别代码，供 judge_online/register_online 使用",
          "used_by": ["judge_online", "register_online"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_dept_doctors",
      "desc": "科室医生 → [{doctor_code, doctor_name, dept_name, speciality}]",
      "need_login": false,
      "params": {
        "dept_code": "真实科室代码",
        "branch_code": "",
        "branch_name": ""
      },
      "keywords": [
        "医生",
        "大夫",
        "专家",
        "哪个医生"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "note": "先调 list_depts 拿到目标科室的真实 dept_code（本才艺科室是两级结构），禁止编造"
        }
      ],
      "provides": {
        "doctor_code": {
          "desc": "医生代码，供 judge_online/register_online 使用",
          "used_by": ["judge_online", "register_online"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_available_dates",
      "desc": "可约日期 → [YYYY-MM-DD, ...]（默认今天~+7天）",
      "need_login": false,
      "params": {
        "dept_code": "真实科室代码",
        "begin_date": "YYYY-MM-DD",
        "end_date": "YYYY-MM-DD",
        "schedule_type": "3"
      },
      "keywords": [
        "可约日期",
        "哪天能约",
        "放号"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "note": "先调 list_depts 拿到目标科室的真实 dept_code，禁止编造"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_schedule",
      "desc": "某科室某天排班 → [{schedule_id, reg_name, noon_code, doctor, detail(时段: time_part/schedule_num_id/remaining_num/is_enable)}]",
      "need_login": false,
      "params": {
        "dept_code": "真实科室代码",
        "begin_date": "YYYY-MM-DD",
        "end_date": "YYYY-MM-DD"
      },
      "keywords": [
        "排班",
        "出诊时间",
        "哪天有号",
        "门诊时间"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "note": "先调 list_depts 拿到目标科室的真实 dept_code，禁止编造"
        }
      ],
      "provides": {
        "schedule_id": {
          "desc": "排班 id，供 get_schedule_detail/register_online 使用",
          "used_by": ["get_schedule_detail", "register_online"]
        },
        "schedule_num_id": {
          "desc": "时段号 id（detail 内），供 register_online 使用",
          "used_by": ["register_online"]
        },
        "time_part": {
          "desc": "时段（detail 内），供 register_online 使用",
          "used_by": ["register_online"]
        },
        "noon_code": {
          "desc": "午别代码，供 register_online 使用",
          "used_by": ["register_online"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "judge_online",
      "desc": "在线号判断（该条件是否可挂在线号）→ data（null=不可，非 null=可）",
      "need_login": false,
      "params": {
        "date": "YYYY-MM-DD",
        "dept_code": "真实科室代码",
        "doctor_code": "",
        "noon_code": ""
      },
      "keywords": [
        "在线号",
        "能否在线挂",
        "网上挂号"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "note": "先调 list_depts 拿到目标科室的真实 dept_code"
        },
        {
          "param": "doctor_code",
          "from": "list_dept_doctors",
          "field": "doctor_code",
          "note": "如需指定医生，先调 list_dept_doctors 拿真实 doctor_code",
          "optional": true
        },
        {
          "param": "noon_code",
          "from": "list_noon_codes",
          "field": "noon_code",
          "note": "午别代码，可先调 list_noon_codes",
          "optional": true
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_schedule_detail",
      "desc": "在线号时段详情 → [{time_part, schedule_num_id, remaining_num, is_enable}]",
      "need_login": false,
      "params": {
        "schedule_id": "排班 id",
        "schedule_day": "YYYY-MM-DD",
        "type": "0"
      },
      "keywords": [
        "时段",
        "号源明细",
        "几点能挂"
      ],
      "requires": [
        {
          "param": "schedule_id",
          "from": "get_schedule",
          "field": "schedule_id",
          "note": "先调 get_schedule 拿到排班的 schedule_id，禁止编造"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_pay_channels",
      "desc": "支付渠道 → [{pay_channel, name, status}]（如 WX_JSAPI 微信支付）",
      "need_login": false,
      "params": {},
      "keywords": [
        "支付渠道",
        "怎么支付",
        "微信支付"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "wechat_login",
      "desc": "微信小程序授权登录 → access_token 存手机本地凭据库。⚠️真人配合：code/encrypted_data/iv 由用户在小程序授权产生（一次性会过期）",
      "need_login": false,
      "params": {
        "code": "微信授权 code",
        "encrypted_data": "微信授权 encrypted_data",
        "iv": "微信授权 iv"
      },
      "keywords": [
        "登录",
        "微信登录",
        "授权"
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_medical_card",
      "desc": "就诊卡/患者信息（需登录）→ [{id, patient_code, is_valid, is_default}]",
      "need_login": true,
      "params": {},
      "keywords": [
        "我的就诊卡",
        "患者信息",
        "就诊人"
      ],
      "provides": {
        "patient_code": {
          "desc": "患者编号，供 register_online 使用",
          "used_by": ["register_online"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "register_online",
      "desc": "在线挂号（POST /api/public/v3/register/online）⚠️真挂号有副作用，须用户确认。需登录；参数由前置查询方法提供（见 requires），禁止编造编码",
      "need_login": true,
      "params": {
        "appointment_time": "YYYY-MM-DD 或完整时间",
        "dept_code": "真实科室代码",
        "dept_name": "科室名",
        "doctor_code": "医生代码",
        "doctor_name": "医生名",
        "id_card": "患者身份证（由用户提供/个人资料中心，非接口返回）",
        "patient_code": "患者编号（来自 get_medical_card）",
        "patient_name": "患者姓名（由用户提供/个人资料中心，非接口返回）",
        "noon_code": "午别代码",
        "schedule_id": "排班 id",
        "schedule_num_id": "时段号 id",
        "time_part": "时段时间",
        "pay_channel": "WX_JSAPI"
      },
      "keywords": [
        "挂号",
        "预约挂号",
        "挂这个科",
        "提交挂号"
      ],
      "requires": [
        {
          "param": "dept_code",
          "from": "list_depts",
          "field": "dept_code",
          "match": { "dept_name": "dept_name" },
          "note": "先用用户给的科室名在 list_depts 结果里精确匹配，取真实 dept_code"
        },
        {
          "param": "dept_name",
          "from": "list_depts",
          "field": "dept_name",
          "match": { "dept_name": "dept_name" },
          "note": "与 dept_code 对应的科室名（用科室名匹配锁定）"
        },
        {
          "param": "doctor_code",
          "from": "list_dept_doctors",
          "field": "doctor_code",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "先 list_depts 定科室，再用医生名在 list_dept_doctors 结果里精确匹配，取真实 doctor_code"
        },
        {
          "param": "doctor_name",
          "from": "list_dept_doctors",
          "field": "doctor_name",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "与 doctor_code 对应的医生名（用医生名匹配锁定）"
        },
        {
          "param": "schedule_id",
          "from": "get_schedule",
          "field": "schedule_id",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "先 list_depts 定科室，再用医生名在 get_schedule 排班结果里精确匹配，取真实 schedule_id"
        },
        {
          "param": "schedule_num_id",
          "from": "get_schedule",
          "field": "detail.schedule_num_id",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "get_schedule 返回匹配排班的 detail 里的 schedule_num_id"
        },
        {
          "param": "time_part",
          "from": "get_schedule",
          "field": "detail.time_part",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "get_schedule 返回匹配排班的 detail 里的 time_part"
        },
        {
          "param": "noon_code",
          "from": "get_schedule",
          "field": "noon_code",
          "match": { "doctor_name": "doctor_name" },
          "pass_params": { "dept_code": "dept_code" },
          "note": "get_schedule 返回匹配排班的 noon_code"
        },
        {
          "param": "patient_code",
          "from": "get_medical_card",
          "field": "patient_code",
          "note": "先调 get_medical_card 拿患者编号（患者列表取默认/第一条）"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_order",
      "desc": "订单详情（需登录）→ {id, order_no, state, is_paid, dept_name, appointment_time}；不传 order_id 时返回订单列表，传则返回该订单详情",
      "need_login": true,
      "params": {
        "order_id": "订单 id（可不传，不传返回订单列表）"
      },
      "keywords": [
        "订单",
        "我的挂号",
        "预约记录"
      ],
      "provides": {
        "order_id": {
          "desc": "订单 id，供 get_order_goods 使用；也用于查询订单详情",
          "used_by": ["get_order_goods", "get_order"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_order_goods",
      "desc": "订单商品详情（需登录）→ {id, order_id, dept_name, doctor_name, appointment_time}",
      "need_login": true,
      "params": {
        "id": "商品/订单 id",
        "type": "appointment"
      },
      "keywords": [
        "订单详情",
        "挂号详情"
      ],
      "requires": [
        {
          "param": "id",
          "from": "get_order",
          "field": "id",
          "note": "先调 get_order 拿到订单 id"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "list_notices",
      "desc": "公告/协议列表（/api/cms/news/category/3912）→ [{id, title, desc, createTime}]",
      "need_login": false,
      "params": {
        "page": "0",
        "size": "10"
      },
      "keywords": [
        "公告",
        "协议",
        "须知"
      ],
      "provides": {
        "id": {
          "desc": "公告 id，供 get_notice_detail 使用",
          "used_by": ["get_notice_detail"]
        }
      },
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    },
    {
      "name": "get_notice_detail",
      "desc": "公告/协议详情（/api/cms/news/{news_id}）→ {id, title, text(html)}",
      "need_login": false,
      "params": {
        "news_id": "公告 id"
      },
      "keywords": [
        "公告详情",
        "协议内容",
        "挂号条款"
      ],
      "requires": [
        {
          "param": "news_id",
          "from": "list_notices",
          "field": "id",
          "note": "先调 list_notices 拿到公告 id"
        }
      ],
      "success_ret": "",
      "error_ret": "",
      "system_only": false
    }
  ]
}
